# -------------------------------------------------------
# eDoc Medical Booking Platform - Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your own values.
# .env is gitignored and should NEVER be committed.

# --- Django ---
SECRET_KEY=your-secret-key-here
DEBUG=True

# --- Database ---
# Leave empty to use the default SQLite database (good for local dev).
# Set to a full PostgreSQL URL for production, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# --- AWS S3 (for image uploads) ---
# Leave empty to store files locally in the /media/ folder.
# Set these in production to use S3 for file storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
